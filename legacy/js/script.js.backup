function generateProyectoTags() {
    const proyectoData = [
        { id: 'proyecto-1-tags', tags: ["Control de mesas", "Pedidos", "Cocina", "Pagos", "Inventario", "Reportes"] },
        { id: 'proyecto-2-tags', tags: ["Registro de pacientes", "Historia clínica", "Citas", "Emergencias", "Reportes"] },
        { id: 'proyecto-3-tags', tags: ["Gráficos", "Indicadores", "Filtros", "Reportes continuos"] },
        { id: 'proyecto-4-tags', tags: ["Automatización", "Memoria local", "Gestión de archivos", "Comandos"] }
    ];

    proyectoData.forEach(item => {
        const container = document.getElementById(item.id);
        if (container) {
            container.innerHTML = item.tags.map(tag => `
                <span class="bg-gray-100 text-gray-600 text-xs px-2.5 py-1 rounded">${tag}</span>
            `).join('');
        }
    });
}

// Ejecutar todas las funciones cuando el DOM esté listo
document.addEventListener('DOMContentLoaded', () => {
    generateProblemas();
    generateModulo1();
    generateModulo2();
    generateModulo3();
    generateModulo4();
    generateProyectoTags();
});